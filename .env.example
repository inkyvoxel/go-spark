# Domain name for Docker deployment (used by Caddyfile and docker-compose.yml).
# Set this to your public domain, e.g. DOMAIN=yourdomain.example
# Not used for local development.
DOMAIN=

DATABASE_PATH=./data/app.db
APP_ADDR=:8080
# APP_PROCESS can be all, web, or worker. The default all mode runs the
# HTTP server and background jobs worker together for local development.
APP_PROCESS=all
LOG_FORMAT=text
APP_COOKIE_SECURE=false
# For local development. Docker deployment derives this from DOMAIN automatically.
APP_BASE_URL=http://localhost:8080
# Root signing secret — flash and ceremony (TOTP/passkey) cookies are signed
# with keys derived from this. Required. Generate with: openssl rand -hex 32
# Keep secret and outside Git. Rotating it is cheap: it signs out no one and
# invalidates no stored data — at most an in-flight TOTP/passkey ceremony restarts.
SECRET_KEY_BASE=
# Root key for TOTP data at rest — encrypts TOTP shared secrets and hashes backup
# codes. Required, and kept separate from SECRET_KEY_BASE so signing-key rotation
# does not touch anyone's second factor. Generate with: openssl rand -hex 32
# Keep secret and outside Git. Rotating this forces every 2FA user to re-enrol
# (both their authenticator secret and backup codes stop validating).
AUTH_TOTP_KEY=
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_EMAIL_CHANGE_NOTICE_ENABLED=true
# Issuer name shown in authenticator apps when users set up two-factor auth.
# Set this to your app's name, e.g. AUTH_TOTP_ISSUER=My App
AUTH_TOTP_ISSUER=Go Spark
# Passkeys (WebAuthn). The Relying Party ID defaults to the host of APP_BASE_URL
# (e.g. localhost, example.com) and the allowed origin is APP_BASE_URL itself, so
# passkeys work out of the box. Override the RP ID only for multi-subdomain setups
# (set it to the registrable parent domain, e.g. example.com). The display name is
# shown in some browser/OS passkey prompts.
AUTH_PASSKEY_RP_ID=
AUTH_PASSKEY_RP_DISPLAY_NAME=Go Spark
# Password pepper prepended before Argon2id hashing. Required.
# Generate with: openssl rand -hex 32
# Keep secret and outside Git. Rotating this invalidates existing password
# verification until users reset passwords.
AUTH_PASSWORD_PEPPER=
EMAIL_FROM="Go Spark <hello@example.com>"
EMAIL_PROVIDER=log
EMAIL_LOG_BODY=false
JOBS_CLEANUP_INTERVAL=1h
JOBS_CLEANUP_TOKEN_RETENTION=24h
JOBS_CLEANUP_SENT_EMAIL_RETENTION=168h
JOBS_CLEANUP_FAILED_EMAIL_RETENTION=336h

# SMTP settings (used when EMAIL_PROVIDER=smtp)
# SMTP_TLS=true upgrades the connection with STARTTLS (standard on port 587).
# Implicit TLS (port 465) is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# Trusted reverse proxy IPs (optional, comma-separated IPs or CIDRs).
# Set this when running behind a reverse proxy (Caddy, nginx, Traefik, etc.)
# so rate limiting uses the real client IP from X-Forwarded-For. The rightmost
# entry not in this list is used; client-supplied entries are never trusted.
# Leave blank to use RemoteAddr directly (correct when there is no proxy).
# Example: TRUSTED_PROXY_IPS=127.0.0.1
# Example: TRUSTED_PROXY_IPS=10.0.0.1,172.16.0.0/12
TRUSTED_PROXY_IPS=

# Rate limit overrides (optional)
# Leave blank to use secure defaults from code.
# The *_PER_IP limits are coarse per-IP ceilings layered on top of the
# per-email limiters; raise them if many legitimate users share one egress IP
# (offices, mobile NAT).
RATE_LIMIT_LOGIN_MAX_REQUESTS=
RATE_LIMIT_LOGIN_WINDOW=
RATE_LIMIT_LOGIN_PER_IP_MAX_REQUESTS=
RATE_LIMIT_LOGIN_PER_IP_WINDOW=
RATE_LIMIT_REGISTER_MAX_REQUESTS=
RATE_LIMIT_REGISTER_WINDOW=
RATE_LIMIT_REGISTER_PER_IP_MAX_REQUESTS=
RATE_LIMIT_REGISTER_PER_IP_WINDOW=
RATE_LIMIT_FORGOT_PASSWORD_MAX_REQUESTS=
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=
RATE_LIMIT_FORGOT_PASSWORD_PER_IP_MAX_REQUESTS=
RATE_LIMIT_FORGOT_PASSWORD_PER_IP_WINDOW=
RATE_LIMIT_RESET_PASSWORD_MAX_REQUESTS=
RATE_LIMIT_RESET_PASSWORD_WINDOW=
RATE_LIMIT_PUBLIC_RESEND_VERIFICATION_MAX_REQUESTS=
RATE_LIMIT_PUBLIC_RESEND_VERIFICATION_WINDOW=
RATE_LIMIT_PUBLIC_RESEND_VERIFICATION_PER_IP_MAX_REQUESTS=
RATE_LIMIT_PUBLIC_RESEND_VERIFICATION_PER_IP_WINDOW=
RATE_LIMIT_ACCOUNT_RESEND_VERIFICATION_MAX_REQUESTS=
RATE_LIMIT_ACCOUNT_RESEND_VERIFICATION_WINDOW=
RATE_LIMIT_CHANGE_PASSWORD_MAX_REQUESTS=
RATE_LIMIT_CHANGE_PASSWORD_WINDOW=
RATE_LIMIT_CHANGE_EMAIL_MAX_REQUESTS=
RATE_LIMIT_CHANGE_EMAIL_WINDOW=
RATE_LIMIT_REVOKE_SESSION_MAX_REQUESTS=
RATE_LIMIT_REVOKE_SESSION_WINDOW=
RATE_LIMIT_REVOKE_OTHER_SESSIONS_MAX_REQUESTS=
RATE_LIMIT_REVOKE_OTHER_SESSIONS_WINDOW=
RATE_LIMIT_DELETE_ACCOUNT_MAX_REQUESTS=
RATE_LIMIT_DELETE_ACCOUNT_WINDOW=
RATE_LIMIT_TOTP_CHALLENGE_MAX_REQUESTS=
RATE_LIMIT_TOTP_CHALLENGE_WINDOW=
RATE_LIMIT_TOTP_DISABLE_MAX_REQUESTS=
RATE_LIMIT_TOTP_DISABLE_WINDOW=
RATE_LIMIT_TOTP_CONFIRM_MAX_REQUESTS=
RATE_LIMIT_TOTP_CONFIRM_WINDOW=
RATE_LIMIT_TOTP_REGENERATE_CODES_MAX_REQUESTS=
RATE_LIMIT_TOTP_REGENERATE_CODES_WINDOW=
RATE_LIMIT_PASSKEY_REGISTER_MAX_REQUESTS=
RATE_LIMIT_PASSKEY_REGISTER_WINDOW=
RATE_LIMIT_PASSKEY_LOGIN_MAX_REQUESTS=
RATE_LIMIT_PASSKEY_LOGIN_WINDOW=
RATE_LIMIT_PASSKEY_MANAGE_MAX_REQUESTS=
RATE_LIMIT_PASSKEY_MANAGE_WINDOW=
